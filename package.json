  "version": "0.1.0",
  "type": "module",
  "description": "NEXORA — Your World of Knowledge. Personal digital knowledge platform.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/feeds.mjs && tsc -b && vite build && node scripts/postbuild.mjs",
